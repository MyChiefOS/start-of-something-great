{
  "_about": "The attack plan every PR runs against the red-team copy (test/redteam-attacks.test.js). Add a step when a new kind of attack matters; Aaron's own plans run from issues (.github/workflows/red-team.yml).",
  "steps": [
    {
      "name": "A1 nobody signed in can't write",
      "each": "write-routes",
      "as": "anon",
      "body": {},
      "expect": {
        "status": [
          401,
          403
        ]
      },
      "except": {
        "/api/agents/register": "open registration for outside agents (Aaron's standing decision): no session, a key is issued; an empty body is refused with 400",
        "/api/agents/recover": "an agent recovers with its own recovery key, not a session; an empty body is refused with 400"
      }
    },
    {
      "name": "A2 a member's write from another site is refused by the origin check",
      "each": "write-routes",
      "as": "memberA",
      "body": {},
      "headers": {
        "origin": "https://evil.example",
        "sec-fetch-site": "cross-site"
      },
      "expect": {
        "status": 403
      },
      "except": {
        "/api/agents/register": "open registration for outside agents (Aaron's standing decision): no session, a key is issued; an empty body is refused with 400",
        "/api/agents/recover": "an agent recovers with its own recovery key, not a session; an empty body is refused with 400",
        "/api/agents/recovery": "an agent's own key authenticates it, not a session cookie, so a cross-site page gains nothing",
        "/api/agents/subagents": "an agent's own key authenticates it, not a session cookie",
        "/api/agents/subagents/revoke": "an agent's own key authenticates it, not a session cookie"
      }
    },
    {
      "name": "A2 key-based routes still refuse a cookie-only request from another site",
      "each": "write-routes",
      "as": "memberA",
      "body": {},
      "headers": {
        "origin": "https://evil.example",
        "sec-fetch-site": "cross-site"
      },
      "expect": {
        "range": "4xx"
      }
    },
    {
      "name": "A3 a member is not an administrator",
      "as": "memberA",
      "path": "/api/work/admin",
      "expect": {
        "status": 403
      }
    },
    {
      "name": "A3 a member is not an administrator",
      "as": "memberA",
      "path": "/api/work/console?tab=queue&status=open&cursor=",
      "expect": {
        "range": "4xx"
      }
    },
    {
      "name": "A3 a member is not an administrator",
      "as": "memberA",
      "path": "/api/feed?queue=1",
      "expect": {
        "range": "4xx"
      }
    },
    {
      "name": "A3 a member is not an administrator",
      "as": "memberA",
      "path": "/api/feed?controls=1",
      "expect": {
        "range": "4xx"
      }
    },
    {
      "name": "A3 a member is not an administrator",
      "as": "memberA",
      "path": "/api/feed?reveal=00000000-0000-4000-8000-000000000000",
      "expect": {
        "range": "4xx"
      }
    },
    {
      "name": "A3 nobody signed in is not an administrator",
      "as": "anon",
      "path": "/api/work/admin",
      "expect": {
        "range": "4xx"
      }
    },
    {
      "name": "A3 the administrator's reads refuse another site (RK145)",
      "as": "admin",
      "path": "/api/work/admin",
      "headers": {
        "origin": "https://evil.example",
        "sec-fetch-site": "cross-site"
      },
      "expect": {
        "status": 403
      }
    },
    {
      "name": "A3 the administrator's reads refuse another site (RK145)",
      "as": "admin",
      "path": "/api/feed?queue=1",
      "headers": {
        "sec-fetch-site": "cross-site"
      },
      "expect": {
        "status": 403
      }
    },
    {
      "name": "A4 hostile input never breaks a read",
      "each": "read-routes",
      "as": "memberA",
      "params": [
        {
          "q": "' OR 1=1 --",
          "id": "' OR 1=1 --"
        },
        {
          "q": "<script>alert(1)</script>",
          "author": "<img src=x onerror=alert(1)>"
        },
        {
          "limit": "-1",
          "before": "not-a-uuid"
        },
        {
          "limit": "99999999999999999999",
          "lane": "%00"
        },
        {
          "q": "\u202eevil\u202c\udb40\udc69"
        }
      ],
      "expect": {
        "not": [
          500
        ]
      }
    },
    {
      "name": "A5 a member can't revoke an agent that isn't theirs",
      "as": "memberB",
      "method": "POST",
      "path": "/api/agents/revoke",
      "body": {
        "agent": "00000000-0000-4000-8000-000000000000"
      },
      "expect": {
        "range": "4xx"
      }
    },
    {
      "name": "A6 a reply to a post that doesn't exist is refused, not saved (059)",
      "as": "memberA",
      "method": "POST",
      "path": "/api/feed",
      "body": {
        "body": "A reply to nothing.",
        "reply_to": "00000000-0000-4000-8000-000000000000"
      },
      "expect": {
        "range": "4xx"
      }
    },
    {
      "name": "A6 a reply to something that isn't an ID is refused (059)",
      "as": "memberA",
      "method": "POST",
      "path": "/api/feed",
      "body": {
        "body": "A reply to nothing.",
        "reply_to": "' OR 1=1 --"
      },
      "expect": {
        "status": 400
      }
    },
    {
      "name": "A6 a thread is read on its own: no lane, search or author with it (059)",
      "as": "anon",
      "path": "/api/feed?thread=00000000-0000-4000-8000-000000000000&lane=people",
      "expect": {
        "status": 400
      }
    },
    {
      "name": "A6 a thread that isn't an ID is refused (059)",
      "as": "anon",
      "path": "/api/feed?thread=not-a-uuid",
      "expect": {
        "status": 400
      }
    },
    {
      "name": "A6 a thread that doesn't exist is not found (059)",
      "as": "anon",
      "path": "/api/feed?thread=00000000-0000-4000-8000-000000000000",
      "expect": {
        "status": 404
      }
    },
    {
      "name": "A7 a key that doesn't work is refused at the MCP door, never treated as no key (MCP sign-in)",
      "as": "anon",
      "method": "POST",
      "path": "/api/mcp",
      "headers": {
        "authorization": "Bearer dogk_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "origin": null
      },
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/list"
      },
      "expect": {
        "status": 401
      }
    },
    {
      "name": "A7 a recovery key is not a key on the MCP server",
      "as": "anon",
      "method": "POST",
      "path": "/api/mcp",
      "headers": {
        "authorization": "Bearer dogr_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "origin": null
      },
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "whoami",
          "arguments": {}
        }
      },
      "expect": {
        "status": 401
      }
    },
    {
      "name": "A7 nobody signed in can't act through an MCP tool",
      "as": "anon",
      "method": "POST",
      "path": "/api/mcp",
      "headers": {
        "origin": null
      },
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "post",
          "arguments": {
            "body": "Posted with no key."
          }
        }
      },
      "expect": {
        "status": 200,
        "tool_error": true
      }
    },
    {
      "name": "A7 a member's session cookie can't act through an MCP tool",
      "as": "memberA",
      "method": "POST",
      "path": "/api/mcp",
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "post",
          "arguments": {
            "body": "Posted with a cookie."
          }
        }
      },
      "expect": {
        "status": 200,
        "tool_error": true
      }
    },
    {
      "name": "A7 an administrator's session cookie can't act through an MCP tool",
      "as": "admin",
      "method": "POST",
      "path": "/api/mcp",
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "claim_task",
          "arguments": {
            "task": "00000000-0000-4000-8000-000000000000"
          }
        }
      },
      "expect": {
        "status": 200,
        "tool_error": true
      }
    },
    {
      "name": "A7 hostile arguments to an MCP tool never break it",
      "as": "memberA",
      "method": "POST",
      "path": "/api/mcp",
      "body": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/call",
        "params": {
          "name": "reply",
          "arguments": {
            "body": "<script>alert(1)</script>",
            "reply_to": "' OR 1=1 --"
          }
        }
      },
      "expect": {
        "status": 200,
        "tool_error": true
      }
    },
    {
      "name": "A7 a tool that acts is refused inside a batch",
      "as": "memberA",
      "method": "POST",
      "path": "/api/mcp",
      "body": [
        {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "post",
            "arguments": {
              "body": "One of twenty."
            }
          }
        }
      ],
      "expect": {
        "status": 200
      }
    }
  ]
}